rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBooking(data) {
      return data.id is string && data.id.size() <= 64
        && data.title is string && data.title.size() <= 256
        && data.bookingType in ['discovery', 'scoping', 'kickoff', 'audit']
        && data.clientName is string && data.clientName.size() <= 128
        && data.clientEmail is string && data.clientEmail.size() <= 128
        && data.date is string && data.date.size() <= 32
        && data.timeSlot is string && data.timeSlot.size() <= 64
        && data.status in ['confirmed', 'in-progress', 'completed', 'cancelled'];
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /bookings/{bookingId} {
      allow read: if isValidId(bookingId);
      allow create: if isValidId(bookingId) && isValidBooking(request.resource.data);
      allow update: if isValidId(bookingId) && isValidBooking(request.resource.data);
      allow delete: if isValidId(bookingId);
    }
  }
}
